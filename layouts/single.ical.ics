{{- /*
  calendario.ics: the events of content/calendario.md (read through the
  partial calendario-eventi.html, which also checks them), in iCalendar
  format (RFC 5545). The fields are documented in calendario.md.

  Lines are collected in $lines and printed at the end, folded at 75 octets
  and each ended by CRLF, as the RFC requires.

  - Times are local to Europe/Rome (DTSTART;TZID=…), described by the
    VTIMEZONE block, so they stay right across the daylight saving change.
  - The UID depends only on the date (or on "id"), so changing the title or
    cancelling an event updates it in the calendars that already have it.
    Two events with the same date or id stop the build.
  - DTSTAMP is the lastmod of the calendar page, not "now": the file stays
    identical between builds until the events change.
*/ -}}
{{- $tz := "Europe/Rome" -}}
{{- $lines := slice
  "BEGIN:VCALENDAR"
  "VERSION:2.0"
  "PRODID:-//Luccalug//Calendario Eventi//IT"
  "CALSCALE:GREGORIAN"
  "METHOD:PUBLISH"
  (printf "X-WR-CALNAME:%s - Eventi" (partial "ical-escape.html" site.Title))
  (printf "X-WR-TIMEZONE:%s" $tz)
  "REFRESH-INTERVAL;VALUE=DURATION:P1D"
  "X-PUBLISHED-TTL:P1D"
  "BEGIN:VTIMEZONE"
  (printf "TZID:%s" $tz)
  "BEGIN:DAYLIGHT"
  "TZOFFSETFROM:+0100"
  "TZOFFSETTO:+0200"
  "TZNAME:CEST"
  "DTSTART:19700329T020000"
  "RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU"
  "END:DAYLIGHT"
  "BEGIN:STANDARD"
  "TZOFFSETFROM:+0200"
  "TZOFFSETTO:+0100"
  "TZNAME:CET"
  "DTSTART:19701025T030000"
  "RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU"
  "END:STANDARD"
  "END:VTIMEZONE"
-}}
{{- $dtstamp := printf "DTSTAMP:%s" (.Lastmod.UTC.Format "20060102T150405Z") -}}
{{- range partialCached "calendario-eventi.html" . -}}
  {{- $lines = $lines | append "BEGIN:VEVENT" (printf "UID:%s@luccalug.it" .key) $dtstamp -}}
  {{- if .allDay -}}
    {{- $lines = $lines | append
      (printf "DTSTART;VALUE=DATE:%s" (.start.Format "20060102"))
      (printf "DTEND;VALUE=DATE:%s" (.end.Format "20060102"))
    -}}
  {{- else -}}
    {{- $lines = $lines | append
      (printf "DTSTART;TZID=%s:%s" $tz (.start.Format "20060102T150405"))
      (printf "DTEND;TZID=%s:%s" $tz (.end.Format "20060102T150405"))
    -}}
  {{- end -}}
  {{- $summary := .summary -}}
  {{- if .cancelled -}}
    {{- /* The prefix is for the clients that ignore STATUS. */ -}}
    {{- $summary = printf "[Annullato] %s" $summary -}}
    {{- $lines = $lines | append "STATUS:CANCELLED" -}}
  {{- end -}}
  {{- $lines = $lines | append (printf "SUMMARY:%s" (partial "ical-escape.html" $summary)) -}}
  {{- with .location -}}
    {{- $lines = $lines | append (printf "LOCATION:%s" (partial "ical-escape.html" .)) -}}
  {{- end -}}
  {{- with .description -}}
    {{- $lines = $lines | append (printf "DESCRIPTION:%s" (partial "ical-escape.html" .)) -}}
  {{- end -}}
  {{- with .url -}}
    {{- $lines = $lines | append (printf "URL:%s" (absURL .)) -}}
  {{- end -}}
  {{- $lines = $lines | append "END:VEVENT" -}}
{{- end -}}
{{- $lines = $lines | append "END:VCALENDAR" -}}
{{- range $lines }}{{ partial "ical-fold.html" . }}{{ "\r\n" }}{{ end -}}
